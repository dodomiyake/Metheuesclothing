# Metheues Clothings — environment
# Copy to .env.local. Never commit .env.local. §12: no old .env files migrated in.

# ---- Supabase (public: these reach the browser, by design) ----
NEXT_PUBLIC_SUPABASE_URL=https://afzuhymegntqjwtdkmfb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ZApXS0AwEtz02kMDLyDaIw_w99AHp9M

# ---- Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_) ----
# Dashboard → Project Settings → API → service_role.
# This key bypasses RLS completely. If it reaches the browser, every customer's
# orders and addresses are readable by anyone.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Resend ----
RESEND_API_KEY=
EMAIL_FROM="Metheues Clothings <orders@metheues.com>"

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pixabay stock photo search, used by A05's "Find a stock photograph".
# Free key from https://pixabay.com/api/docs/. Server-side only — never
# NEXT_PUBLIC_, because a key in the browser is a key anyone can spend the
# 100-requests-per-minute allowance with. Optional: without it the search
# panel returns a 503 saying it is not configured, and uploading a file by
# hand still works.
PIXABAY_API_KEY=
